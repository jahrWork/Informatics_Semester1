{
    // ─── Python ───────────────────────────────────────────────────────────────
    "python-envs.defaultEnvManager": "ms-python.python:system",
    "python-envs.defaultPackageManager": "ms-python.python:pip",
    "python-envs.pythonProjects": [],

    // ─── Asociaciones de ficheros ──────────────────────────────────────────────
    "files.associations": {
        "*.tex": "latex",
        "*.sty": "latex",
        "*.cls": "latex"
    },

    // ─── Ocultar ficheros auxiliares LaTeX del explorador ─────────────────────
    "files.exclude": {
        "**/*.aux": true,
        "**/*.log": true,
        "**/*.synctex.gz": true,
        "**/*.fls": true,
        "**/*.fdb_latexmk": true,
        "**/*.out": true,
        "**/*.toc": true
    },

    // ─── LaTeX Workshop ───────────────────────────────────────────────────────

    // Herramienta: pdflatex directo (sin latexmk ni Perl)
    "latex-workshop.latex.tools": [
        {
            "name": "pdflatex",
            "command": "pdflatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "%DOC%"
            ]
        }
    ],

    // Receta: compilar dos veces para referencias cruzadas
    "latex-workshop.latex.recipes": [
        {
            "name": "pdflatex x2",
            "tools": ["pdflatex", "pdflatex"]
        }
    ],
    "latex-workshop.latex.recipe.default": "pdflatex x2",

    // Visor de PDF: pestaña integrada de LaTeX Workshop (con SyncTeX)
    "latex-workshop.view.pdf.viewer": "tab",

    // Limpiar ficheros auxiliares: desactivado (latexmk necesita Perl)
    // Los .aux/.log/etc. ya están ocultos en el explorador via files.exclude
    "latex-workshop.latex.autoClean.run": "never"
}
